{
  "name": "Problem A - Real Estate Lead Qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "real-estate-lead",
        "responseMode": "responseNode"
      },
      "id": "lead-webhook",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "lead_id",
              "value": "={{$json.lead_id || $json.id || $execution.id}}",
              "type": "string"
            },
            {
              "name": "timestamp",
              "value": "={{$json.timestamp || $now.toISO()}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true
      },
      "id": "normalize-lead",
      "name": "Normalize Lead Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/api/leads/analyze",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "score-lead",
      "name": "AI Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 0]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.intelligence.score}}",
              "operation": "largerEqual",
              "value2": 8
            }
          ],
          "string": [
            {
              "value1": "={{$json.assignment.route}}",
              "operation": "equals",
              "value2": "hot"
            }
          ]
        }
      },
      "id": "hot-lead-check",
      "name": "Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 0]
    },
    {
      "parameters": {
        "url": "https://hooks.slack.com/services/REPLACE_ME",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\"text\":\"Hot lead: {{$json.lead.name}} scored {{$json.intelligence.score}}. Next action: {{$json.assignment.next_action}}\"}"
      },
      "id": "notify-sales",
      "name": "Notify Sales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1020, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crm.example.com/api/leads",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "crm-sync",
      "name": "CRM Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1020, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "respond",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1280, 0]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Normalize Lead Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Lead Payload": {
      "main": [
        [
          {
            "node": "AI Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Score Lead": {
      "main": [
        [
          {
            "node": "Hot Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hot Lead?": {
      "main": [
        [
          {
            "node": "Notify Sales",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CRM Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Sales": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM Sync": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
